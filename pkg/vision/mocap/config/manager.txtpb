camera_service: "mocap_camera.job.local.cluster.internal"
# make_dummy_cameras: true

initial_camera_config {
    frame_rate: 0
    exposure_micros: 250
    # Rift CV1 cameras (rift_camera): dark level 18 + 12.
    pixel_threshold: 30
    strobe_power: 0.2

    leds_on: true

    # TODO: Dedup.
    blob_filter {
        min_area: 6
        max_area: 10000 # 100 x 100
        reject_edge: true
        max_bbox_aspect_ratio: 1.5
        # Small blobs always cover more pixels than pi * a * b (their faint
        # rim counts in the area but hardly in the weighted radii): 2.6 px
        # markers (20 mm at 5.5 m) reach -1.48, so 0.25 rejected them all.
        # rift_camera's rift_blob_sim: 1.5 accepts 100% from 2.6 to 60 px;
        # a real diffused LED reaches -1.68, hence 3.0 (rejects only blobs
        # covering over 4x their ellipse).
        elliptical_area_error: 3.0
        max_radius_ratio: 1.5
        max_centroid_bbox_skew {
            abs: 1
            rel: 0.05
        }
    }

    # TODO: Dedup.
    mjpeg {
        # 90, not 100: half the encode time and a third of the JPEG, so
        # previews barely touch the blob path on a Rift node.
        quality: 90
        downsampling: 1
        max_fps: 5
    }
}

# Rift CV1 cameras on Pi 1 (rift_camera; ids from the SHA-256 of the serial),
# named in sorted serial order until the cameras are mounted.
per_camera { camera_id_str: "f8m1js0ghepxk"  name: "C1"  enabled: true }  # WMTD305350189Q, 169.254.10.1
per_camera { camera_id_str: "bncjqw1wt4qjh"  name: "C2"  enabled: true }  # WMTD3062200XGN, 169.254.10.2
per_camera { camera_id_str: "n1htkyampn4b5"  name: "C3"  enabled: true }  # WMTD3079700ZW1, 169.254.10.3
per_camera { camera_id_str: "kz05rnewgy1fe"  name: "C4"  enabled: true }  # WMTD307A200J7A, 169.254.10.4

sphere_projection_filter {
    min_angle_check_radius_ratio: 1.2
    max_angle_error_degrees: 10
    max_normalized_radius_ratio: 1.2
}

# TODO: Need this based on a P99
frame_aggregation_timeout: 0.020  # 20ms

matching {
    min_num_matches: 3
    min_num_rematches: 2
    max_reprojection_error: 2.0
    min_marker_distance: 0.015
    ghosting_limit_secs: 0.4

    predictor_alpha: 0.95
    predictor_beta: 0.6
    max_marker_speed: 5

    max_point_jump: 0.1

    min_old_point_matching_ratio: 1.5

    fast_rematch_old_points: true

    # rift_solve_bench: matching the same on any number of threads; with 4,
    # a re-found skeleton's frame takes 1.6 ms instead of 3.1 and very fast
    # markers a median 0.66 ms instead of 1.05.
    search_threads: 4
}

wand {
    # Breadboard wand: Dennis's T (0.25 / 0.125 / 0.2) at 85% along the
    # diagonal of a 25 mm grid plate: 6, 3 and 4 steps of 35.355 mm.
    left_arm_length: 0.21213
    right_arm_length: 0.10607
    bottom_length: 0.14142
    # Placeholder, about right: the plate has no feet yet. Only Set Origin
    # uses it (the floor's level); measure floor to sphere centres.
    height: 0.0595

    # The Rift's lens is about 710 px to Dennis's 1450, and the wand is 85%
    # of his, so the same sighting spans 0.42x the pixels. At 20 px the
    # 106 mm arm passed only within 3.8 m face on (2.7 m at 45 degrees) and
    # the handle within 5.0 m (3.5 m); at 10 px, 7.5 m (5.3 m) and 10 m.
    min_blob_center_pixel_distance: 10.0
    max_blob_center_pixel_distance: 500.0
    max_radius_ratio: 2.0
    max_projection_stretch: 1.5
    max_reprojection_error: 5.0
    collinear_pixel_threshold: 3.0
    min_bottom_line_pixel_distance: 10.0

    # The markers stand on a plate, seen from above only. A first wanding
    # held 1-2% of sightings from the back (reflections), each fitting its
    # own camera and 35 px off between cameras: a 7 px solve.
    one_sided: true
}

checkerboard {
    grid_width: 8
    grid_height: 13
    square_size: 0.04
}

wanding {
    max_wand_frame_error: 1
    camera_height_guess: 2.1
    # The Rift node reports each camera's own factory calibration, already
    # undistorted to a pinhole: solving for focal length, centre and k1/k2 as
    # well ran away on a first wanding (f 415 to 817 px, 6.3 px error).
    freeze_intrinsics: true
    # Frames the solution can't fit to 1 px in every camera are dropped and
    # the rest solved again (sightings that are part reflection fit their own
    # camera and nothing else).
    max_solved_frame_error: 1
}

rigid_body_tracker {
    body_config {
        min_initial_match_points: 4
        min_rematch_points: 3
        min_matching_edge_length: 0.05 # 50mm
        max_matching_edge_length: 1 # 1 meter
        max_error: 0.005 # 5mm
    }
}

skeleton_tracker {

    search {
        max_model_point_distance: 0.25
        min_standstill_time_secs: 2
        max_standstill_distance: 0.1
        max_skeleton_scan_fps: 10
    }
}

aux_rpc_server {
    port: 50051
}

